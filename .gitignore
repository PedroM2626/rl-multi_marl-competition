# Environments and tooling
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
.venv-*/
venv/
# Anchored on purpose: an unanchored env/ also matches any source directory named env (case-insensitive
# on this host), which is how a real src/env package once got silently untracked.
/env/
.idea/
.vscode/
dist/
build/
*.egg-info/
.pytest_cache/

# Console transcripts of local training and baseline runs. They duplicate what the versioned JSON
# artefacts already record, and a stale one is worse than none.
/study_run.log
/baseline_*.log
/ctde_arena/baseline_*.log

# Local scratch that must never be mistaken for experiment output
**/_untrained_scratch/
.coverage
htmlcov/

# MLflow's local file store: binary model artefacts and duplicated checkpoints.
# The logged points are exported to ctde_arena/data/mlflow_export/ instead.
mlruns/

# Orphaned history from CSV schema rotations (MetricsStore._rotate_csv_if_schema_changed).
# These are pre-rename or pre-schema-change copies; the live files beside them are versioned.
**/data/metrics/*.legacy*.csv

# Experiment artefacts under **/data/ ARE versioned on purpose: they are the evidence
# behind every number in docs/. Patterns here used to be root-anchored ("data/metrics/*.csv"),
# which silently excluded experiment 1 while committing experiment 2.

# Per-run study scratch (checkpoints, per-step trajectory CSVs). The aggregated analysis
# it produces is versioned under results/study/ instead.
**/data/runs/
