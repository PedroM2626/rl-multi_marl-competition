# Environments and tooling
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
.venv-*/
venv/
# Anchored on purpose: an unanchored env/ also matches any source directory named env (case-insensitive
# on this host), which is how a real src/env package once got silently untracked.
/env/
.idea/
.vscode/
dist/
build/
*.egg-info/
.pytest_cache/

# Console transcripts of local training and baseline runs. They duplicate what the versioned JSON
# artefacts already record, and a stale one is worse than none.
/study_run.log
/baseline_*.log
/ctde_arena/baseline_*.log

# Local scratch that must never be mistaken for experiment output
**/_untrained_scratch/
.coverage
htmlcov/

# MLflow's local file store: binary model artefacts and duplicated checkpoints.
# The logged points are exported to ctde_arena/data/mlflow_export/ instead.
mlruns/

# Orphaned history from CSV schema rotations (MetricsStore._rotate_csv_if_schema_changed).
# These are pre-rename or pre-schema-change copies; the live files beside them are versioned.
**/data/metrics/*.legacy*.csv

# Experiment artefacts under **/data/ ARE versioned on purpose: they are the evidence
# behind every number in docs/. Patterns here used to be root-anchored ("data/metrics/*.csv"),
# which silently excluded experiment 1 while committing experiment 2.

# Per-run study scratch (checkpoints, per-step trajectory CSVs). The aggregated analysis
# it produces is versioned under results/study/ instead. The glob covers data/runs_v2/, the
# arena-v2 replication of the same study, so a second campaign cannot accidentally become
# tracked evidence while the first one is ignored.
**/data/runs*/

# Round-robin run directories. One directory per (training block, harness seed); the pooled CSVs under
# results/cross_arena/ are those same team-matches with the two replication columns joined on, so the split
# copies are reproducible scratch rather than evidence.
# cross_arena_blocks/ is the thirty-run six-block loop, cross_arena_v2_blocks/ the same networks played under
# the arena-v2 termination and reward rules, and cross_arena_campaign/ the ablation checkpoint sets -- all
# three are re-derivable with the commands in docs/09 section 9.3.
/results/cross_arena_blocks/
/results/cross_arena_v2_blocks/
/results/cross_arena_campaign/
# cross_arena_capacity/ is the same scratch again for the two capacity arms, three blocks each.
/results/cross_arena_capacity/
# results/traces/ is the re-training campaign's own aggregate: the committed artefact it produces is
# results/trace_analysis.json, and the per-seed rows duplicate results/study/ by construction.
/results/traces/
# Per-arm intermediates of the readout campaign: one CSV per experiment per temperature, merged into
# results/readout/T<temperature>/per_seed_metrics.csv, which is the artefact report_study.py reads.
/results/readout/parts/
/ctde_arena/results/readout/parts/
