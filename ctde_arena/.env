ARENA_SIZE=32
MATCH_DURATION_SECONDS=90
AGENT_MOVE_SPEED=4.5
AGENT_TURN_SPEED=110
JUMP_SPEED=6.3
GRAVITY=14.0
SHOOT_RANGE=20.0
SHOOT_COOLDOWN=0.45
# Reward and termination knobs, listed so this file describes the instrument the study used rather than
# only the knobs that existed when it was written. These are the committed arena's values and equal the
# code defaults in src/marl_arena/config.py; arena v2 (../docs/08_results.md#arena-v2) lowers the alive
# bonus to 0.0015, turns the 30 s half-life decay on and makes a clock-out a draw, and the ablation arms
# (../docs/08_results.md#ablations) each change one other key. See A-34 for why these are config at all.
REWARD_ALIVE_BONUS=0.015
REWARD_ALIVE_DECAY_HALF_LIFE_S=0
REWARD_KILL=1.2
REWARD_DEATH=-0.5
REWARD_HIT=-1.0
TERMINATION_CAP_AWARDS_WIN=true
PLOT_UPDATE_INTERVAL=1.0
METRICS_FLUSH_INTERVAL=1.5
# The slot-to-paradigm mapping is seed % 3, and the checkpoints shipped in data/checkpoints/ were
# trained at rotation 2, so a demo that loads them needs seed % 3 == 2. See data/PROVENANCE.json.
RANDOM_SEED=2
SIM_STEP_DT=0.1
DOMAIN_RANDOMIZATION=true
RL_TRAIN_TOTAL_STEPS=1000000
RL_SAVE_EVERY_STEPS=100000
RL_LOG_EVERY_STEPS=50000
RL_METRICS_EVERY_MATCHES=10
RL_LEARNING_RATE=0.0003
RL_GAMMA=0.99
RL_GAE_LAMBDA=0.95
RL_CLIP_EPS=0.2
RL_VALUE_COEF=0.5
RL_ENTROPY_COEF=0.01
RL_MAX_GRAD_NORM=0.5
RL_PPO_EPOCHS=4
RL_BATCH_SIZE=256
RL_HIDDEN_DIM=128
# The held-out readout: 0 is argmax, the readout every published number was measured with.
# A positive value samples the policy at that softmax temperature (docs/08_results.md#readout-divergence).
EVAL_TEMPERATURE=0
RL_DEVICE=cpu
DR_ARENA_SIZE_MIN=28
DR_ARENA_SIZE_MAX=36
DR_MATCH_DURATION_MIN=60
DR_MATCH_DURATION_MAX=120
DR_MOVE_SPEED_MIN=3.5
DR_MOVE_SPEED_MAX=5.5
DR_TURN_SPEED_MIN=90
DR_TURN_SPEED_MAX=130
DR_SHOOT_RANGE_MIN=16
DR_SHOOT_RANGE_MAX=24
DR_SHOOT_COOLDOWN_MIN=0.35
DR_SHOOT_COOLDOWN_MAX=0.6
DR_OBSTACLE_COUNT_MIN=5
DR_OBSTACLE_COUNT_MAX=10
